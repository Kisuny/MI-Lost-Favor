# FTB Quests Lang Splitter
# ignore original lang files like en_us.snbt
src/config/ftbquests/quests/lang/*.snbt

# ignore recovery files
src/config/ftbquests/quests/lang/recovery/*.snbt

# ignore already merged files
src/config/ftbquests/quests/lang/**/*.snbt_merged

# Probejs 
src/kubejs/config/probe-settings.json
src/kubejs/server_scripts/jsconfig.json
src/kubejs/startup_scripts/jsconfig.json
src/kubejs/client_scripts/jsconfig.json

kubejs/package.json
.vscode/settings.json
