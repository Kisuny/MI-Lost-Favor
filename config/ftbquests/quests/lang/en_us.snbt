	quest.6621095DCFF9AE0F.quest_desc: ["&aCrush ore&r and other things into &l&epowder&r, with &eincreased yield&r!"]
	quest.662C013A5E66F0B9.quest_desc: [
		"Turns &bwater into steam&r, but require manual maintenance via gentle &l&eaxe rubs&r"
		""
		"Automatically outputs &bsteam&r from all sides, so be &caware&r not to clog up your water pipes with steam"
	]
	quest.6698E9FBE3C24DE8.quest_desc: [
		"&l&eBronze tanks&r can store &e4 buckets of fluid&r each, you can use them to interact with machines, and you can place them in the world."
		""
		"When placed in the world, you can &aright-click&r them with &l&ebuckets or other tanks&r to transfer fluids."
		""
		"Also, you can &astack them&r in your inventory if they have the same contents. How nifty!"
	]
	quest.6728D3D62F6812D6.quest_desc: [
		"Automatic farm with 2 configurable sizes."
		""
		"Will turn grass into farmland around itself, hydrate soil when provoded with water, plant crops when provided with seeds and harvest all the crops if there's enough output room for everything that could be harvested from plants (e.g. for wheat you need 2 output slots: one for seeds and one for wheat itself)"
	]
	quest.6728D3D62F6812D6.quest_subtitle: "Your ultimate farming solution!"
	quest.672EEF1A13EC159D.quest_desc: ["90~"]
	quest.673E8DF15D5D30CA.quest_desc: [
