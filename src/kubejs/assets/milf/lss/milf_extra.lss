#eq_header {
  background: sdf(#1c1926, 0);
}

#eq_title {
  text-color: #ffffff;
}

#eq_chapters .eq_chapter.eq_selected {
  base-background: sdf($(row_selected), 2, 1, $(accent));
  hover-background: sdf($(row_selected), 2, 1, $(accent_hover));
  pressed-background: sdf($(row_selected), 2, 1, $(accent_pressed));
}

#eq_chapters .eq_chapter.eq_selected .__button_text__ {
  text-color: #ffffff;
}

#eq_graph {
  background: shader(embersquesting:space, U_SkyColor=#ff1b1824, U_Color=#80848dcb, U_Color2=#609ea5d6);
}

.__confirm-button__ {
  base-background: sdf($(row_selected), 2, 1, $(accent));
  hover-background: sdf($(raised_hover), 2, 1, $(accent_hover));
  pressed-background: sdf($(raised_pressed), 2, 1, $(accent_pressed));
}

.__reject-button__ {
  base-background: sdf(#5a2a36, 2, 1, $(danger));
  hover-background: sdf(#6e3442, 2, 1, $(danger_hover));
  pressed-background: sdf(#46202a, 2, 1, $(danger_pressed));
}

.__confirm-button__ .__button_text__, .__reject-button__ .__button_text__ {
  text-color: #ffffff;
  text-shadow: true;
}
